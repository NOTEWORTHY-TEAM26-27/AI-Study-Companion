# Copy to .env, then load with: set -a; source .env; set +a
HOST=127.0.0.1
PORT=8000
DOCUMENTS_DIR=data/documents
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2:3b

# Answer model: ollama (local, default) or digitalocean (hosted, uses prepaid credit).
AI_PROVIDER=ollama
# DIGITALOCEAN_API_KEY=
# DIGITALOCEAN_MODEL=anthropic-claude-5.5-haiku
# Optional: longest reply in tokens (default 4096), temperature (not sent unless
# set; newer Claude models reject it), and reasoning effort (low, medium, or high).
# DIGITALOCEAN_MAX_TOKENS=4096
# DIGITALOCEAN_TEMPERATURE=
# DIGITALOCEAN_REASONING_EFFORT=

# Passage search: keyword (local app default) or embedding (search by meaning).
# Docker Compose uses embedding unless this is set. The local app downloads the
# search model (about 90 MB) the first time embedding is used.
# RETRIEVAL=embedding

# Docker Compose uses these separately from the local app's PORT and OLLAMA_URL.
COMPOSE_PORT=8000
COMPOSE_OLLAMA_URL=http://host.docker.internal:11434/api/generate
