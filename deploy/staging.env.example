# Copy to .env in the repo folder on the staging server. Never commit .env.

# The Droplet's Reserved IP with dashes, plus .sslip.io
STAGING_HOST=203-0-113-10.sslip.io

# Shared staging login (HTTP basic auth in Caddy) until student accounts arrive.
# Make the hash with: docker run --rm -i caddy:2 caddy hash-password
# Keep the single quotes: the hash contains $ signs.
STAGING_USER=noteworthy
STAGING_PASSWORD_HASH='$2a$14$replace.with.the.hash.from.caddy.hash-password'

# Hosted answer model (SCRUM-60). Paste the DigitalOcean model access key on the server only.
# Without a key, answers return 503; upload and quiz still work.
AI_PROVIDER=digitalocean
DIGITALOCEAN_API_KEY=

# Passage search uses embedding (search by meaning) unless set. RETRIEVAL=keyword
# switches back to keyword search.
# RETRIEVAL=keyword
