# Copy to .env in the repo folder on the staging server. Never commit .env.

# The Droplet's Reserved IP with dashes, plus .sslip.io
STAGING_HOST=203-0-113-10.sslip.io

# Database password (SCRUM-225). Leave it out: scripts/deploy_staging.sh adds a random one on
# the first deploy and never prints it. Never change or delete it after that, because the
# database keeps the password it was created with (see deploy/STAGING.md).
# POSTGRES_PASSWORD=

# Hosted answer model (SCRUM-60). Paste the DigitalOcean model access key on the server only.
# Without a key, answers return 503; upload and quiz still work.
AI_PROVIDER=digitalocean
DIGITALOCEAN_API_KEY=

# Passage search uses embedding (search by meaning) unless set. RETRIEVAL=keyword
# switches back to keyword search.
# RETRIEVAL=keyword

# Student accounts. Leave CLASS_CODE unset until the login and sign-up screens (SCRUM-146) are
# merged: the current page has no login, so with accounts on every API call returns 401.
# When it is set, also set COOKIE_SECURE=1 (staging uses HTTPS). The code must be at least
# 16 characters; make a random one with:
# python -c "import secrets; print(secrets.token_urlsafe(12))"
# CLASS_CODE=
# COOKIE_SECURE=1
# SESSION_DAYS=7
