# Copy to .env in the repo folder on the staging server. Never commit .env.

# The Droplet's Reserved IP with dashes, plus .sslip.io
STAGING_HOST=203-0-113-10.sslip.io

# Hosted answer model (SCRUM-60). Paste the DigitalOcean model access key on the server only.
# Without a key, answers return 503; upload and quiz still work.
AI_PROVIDER=digitalocean
DIGITALOCEAN_API_KEY=
